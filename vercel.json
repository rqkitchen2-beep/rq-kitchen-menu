{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.rqkitchen.app"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "apps.rqkitchen.app"
        }
      ],
      "destination": "/apps.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "ios-status": false
    }
  },
  "redirects": [
    {
      "source": "/inventory",
      "has": [
        {
          "type": "host",
          "value": "apps.rqkitchen.app"
        }
      ],
      "destination": "https://github.com/rqkitchen2-beep/rq-kitchen-menu/releases/download/android-inventory/RQ-Inventory.apk",
      "permanent": false
    },
    {
      "source": "/attendance",
      "has": [
        {
          "type": "host",
          "value": "apps.rqkitchen.app"
        }
      ],
      "destination": "https://github.com/rqkitchen2-beep/rq-kitchen-menu/releases/download/android-attendance/RQ-Attendance.apk",
      "permanent": false
    },
    {
      "source": "/cashier",
      "has": [
        {
          "type": "host",
          "value": "apps.rqkitchen.app"
        }
      ],
      "destination": "https://github.com/rqkitchen2-beep/rq-kitchen-menu/releases/download/android-cashier/RQ-Cashier.apk",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "menu.rqkitchen.app"
        }
      ],
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/index",
      "has": [
        {
          "type": "host",
          "value": "menu.rqkitchen.app"
        }
      ],
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/apk",
      "destination": "https://github.com/rqkitchen2-beep/rq-kitchen-menu/releases/download/android-branch/RQ-Branch.apk",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "/legal#privacy",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "/legal#terms",
      "permanent": false
    },
    {
      "source": "/refund",
      "destination": "/legal#refund",
      "permanent": false
    },
    {
      "source": "/delivery-policy",
      "destination": "/legal#delivery",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(app|driver|branch|app.html|driver.html|branch.html)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}