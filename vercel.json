{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.rqkitchen.app"
        }
      ],
      "destination": "/app.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "ios-status": false
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "menu.rqkitchen.app"
        }
      ],
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/index",
      "has": [
        {
          "type": "host",
          "value": "menu.rqkitchen.app"
        }
      ],
      "destination": "/app",
      "permanent": false
    }
  ]
}