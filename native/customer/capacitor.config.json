{
  "appId": "com.rqkitchen.app",
  "appName": "RQ Kitchen",
  "webDir": "www",
  "backgroundColor": "#F39A2B",
  "ios": {
    "contentInset": "never",
    "scheme": "RQ Kitchen",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#F39A2B",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "DEFAULT",
      "overlaysWebView": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}