{
  "appId": "com.rqkitchen.app",
  "appName": "RQ Kitchen",
  "webDir": "www",
  "backgroundColor": "#ffffff",
  "server": {
    "url": "https://menu.rqkitchen.app/app",
    "allowNavigation": ["menu.rqkitchen.app", "app.rqkitchen.app"]
  },
  "ios": {
    "contentInset": "never",
    "scheme": "RQ Kitchen",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "backgroundColor": "#ffffff", "showSpinner": false, "launchAutoHide": true },
    "StatusBar": { "style": "LIGHT", "overlaysWebView": true }
  }
}
