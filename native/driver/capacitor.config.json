{
  "appId": "com.rqkitchen.driver",
  "appName": "RQ Driver",
  "webDir": "www",
  "backgroundColor": "#1a1a1a",
  "ios": {
    "contentInset": "never",
    "scheme": "RQ Driver",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#1a1a1a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    }
  }
}